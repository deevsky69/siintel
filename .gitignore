# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
!.env.example
!.env.production.example

# Data resmi / sensitif — hanya data/sample yang boleh di-commit
data/raw/*
data/import/*
data/processed/*
data/tiles/*
!data/**/.gitkeep
!data/tiles/README.md

# JavaScript / TypeScript
node_modules/
.next/
dist/
build/
coverage/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Database lokal
*.sqlite
*.db

# Artefak build & test
playwright-report/
test-results/

# APK hasil build. Berkasnya besar dan dibangun ulang dari sumber; yang dibagikan adalah
# berkas rilisnya, bukan riwayat git.
/dist/

# Berkas lampiran laporan masyarakat. Isinya foto, suara, dan video dari warga — data
# pribadi yang tidak boleh masuk ke repositori dalam keadaan apa pun.
var/lampiran/
