<?xml version="1.0" encoding="utf-8"?>
<!--
  Kepercayaan sertifikat dan larangan HTTP polos.

  JANGKAR CA SATUAN SUDAH DIHAPUS — 9 September 2026.

    Berkas ini sebelumnya menambahkan CA milik satuan sebagai jangkar kepercayaan untuk
    `siintel.awansurya.com`, karena server demo memakai sertifikat swatandatangan. Sejak
    7 September 2026 domain itu dilayani sertifikat Let's Encrypt yang sah, sehingga
    jangkar tambahan tidak lagi diperlukan — dan membawanya terus berarti memperluas
    permukaan kepercayaan tanpa alasan: siapa pun yang memegang kunci CA satuan dapat
    menyamar sebagai server ini bagi aplikasi ini saja. Rencana penghapusannya memang
    sudah tertulis sejak awal (`docs/10` §3.2).

  MENGAPA BERKAS INI TETAP ADA MESKI ISINYA TINGGAL SATU LARANGAN

    `cleartextTrafficPermitted="false"` BUKAN pengulangan setelan bawaan di sini.
    Android melarang HTTP polos secara bawaan hanya sejak API 28, sedangkan `minSdk`
    aplikasi ini 24 — dipilih rendah dengan sengaja agar dapat dipasang pada ponsel murah
    yang sudah lama. Pada Android 7 dan 8, tanpa berkas ini, HTTP polos justru DIIZINKAN.
    Menghapusnya akan melonggarkan keamanan tepat pada perangkat yang paling rentan.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
