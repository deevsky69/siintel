<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_950"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.12"
            android:text="@string/subtitle"
            android:textAllCaps="true"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/home_lead"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/box_critical"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emergency_title"
                android:textColor="@color/critical"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Imbauan yang sedang berlaku — "info sekitar" pada spesifikasi §4. Diletakkan
             SEBELUM tombol lapor: warga yang membuka aplikasi karena melihat sesuatu perlu
             tahu lebih dulu apakah hal itu sudah diketahui satuan. Seluruh bagian ini
             disembunyikan bila tidak ada imbauan atau jaringan gagal — kotak kosong pada
             layar muka terbaca seperti aplikasi yang rusak. -->
        <LinearLayout
            android:id="@+id/alertSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/home_alerts_title"
                android:textAllCaps="true"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/alertList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/home_alerts_basis"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/reportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:backgroundTint="@color/accent"
            android:paddingVertical="14dp"
            android:text="@string/home_report"
            android:textColor="@color/base_950"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/home_report_hint"
            android:textColor="@color/ink_faint"
            android:textSize="12sp" />

        <Button
            android:id="@+id/officerButton"
            style="@style/OutlineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingVertical="14dp"
            android:text="@string/home_officer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/home_officer_hint"
            android:textColor="@color/ink_faint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:textColor="@color/ink_faint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
