# ===========================================================================
# PREDIKSI PRESISI — contoh environment PRODUKSI
#
# Cara pakai:
#   1. cp .env.production.example .env.production
#   2. isi setiap nilai yang masih kosong (lihat penjelasan di tiap bagian)
#   3. chmod 600 .env.production
#
# .env.production TIDAK BOLEH di-commit. Berkas contoh ini sengaja dikosongkan
# pada seluruh nilai rahasia (CLAUDE.md §28).
#
# Panduan langkah demi langkah: docs/10-panduan-deployment.md
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. DOMAIN DAN SERTIFIKAT
# ---------------------------------------------------------------------------

# Nama domain yang sudah diarahkan (A record) ke alamat IP server ini.
# Tulis TANPA https:// dan tanpa garis miring di akhir.
# Contoh isian: prediksipresisi.id
#
# WAJIB DIISI pada kedua jalur deployment. Nilai ini dipakai untuk aturan perutean
# reverse proxy sekaligus daftar origin CORS yang diizinkan API.
DOMAIN=

# Alamat surel untuk pendaftaran sertifikat Let's Encrypt.
#
# HANYA DIPERLUKAN PADA JALUR B (reverse proxy Caddy milik kita sendiri).
# Pada JALUR A — yang dipakai server demo ini — sertifikat diterbitkan oleh Traefik
# milik Coolify yang sudah terpasang, dan alamat surelnya sudah diatur di sana.
# Boleh dibiarkan kosong bila memakai JALUR A. Lihat docs/10 §2.
ACME_EMAIL=


# ---------------------------------------------------------------------------
# 2. DATABASE
# ---------------------------------------------------------------------------

# Nama pengguna database. Boleh dibiarkan seperti ini.
POSTGRES_USER=predpol

# Kata sandi database.
#
# PENTING: nilai ini disusun menjadi URL koneksi di dalam docker-compose.prod.yml,
# jadi gunakan HANYA huruf dan angka. Tanda seperti @ : / # ? akan merusak URL.
#
# Buat nilai acak dengan perintah:
#     openssl rand -hex 24
POSTGRES_PASSWORD=

# Nama database. Boleh dibiarkan seperti ini.
POSTGRES_DB=prediksi_presisi


# ---------------------------------------------------------------------------
# 3. AUTENTIKASI
# ---------------------------------------------------------------------------

# Kunci penanda tangan token sesi.
#
# WAJIB DIISI. Minimal 32 byte — API sengaja MENOLAK START bila nilai ini kosong
# atau terlalu pendek saat APP_ENV=production
# (apps/api/src/prediksi_presisi_api/config.py).
#
# Buat nilai acak dengan salah satu perintah berikut:
#     openssl rand -base64 48
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Mengganti nilai ini akan mengakhiri seluruh sesi yang sedang berjalan.
# Jangan menggantinya di sela-sela paparan.
JWT_SECRET=

# Umur access token (menit) dan refresh token (hari).
# Nilai di bawah adalah default teknis; kebijakan resmi menunggu pemilik proyek (U-05).
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7


# ---------------------------------------------------------------------------
# 4. WAKTU DAN DATA DEMO
# ---------------------------------------------------------------------------

# Zona waktu tampilan. Penyimpanan di database selalu UTC.
APP_TIMEZONE=Asia/Jakarta

# Jam acuan aplikasi. Data sintetis berakhir 31 Desember 2025; tanpa ini seluruh
# panel "24 jam terakhir" akan kosong saat paparan.
#
# Nilainya 31 Desember, BUKAN tanggal lain sebelum itu. Penilaian risiko utama
# (133 baris) bertanggal 31 Desember, sehingga acuan yang lebih awal membuat layar
# menampilkan penilaian yang bertanggal di MASA DEPAN relatif terhadap "sekarang" —
# janggal dibaca dan sulit dijelaskan di depan penguji.
#
# Pukul 21.00 dipilih supaya "sekarang" berada di dalam jendela rawan 18:00-23:59.
DEMO_REFERENCE_TIME=


# ---------------------------------------------------------------------------
# 5. OPERASIONAL
# ---------------------------------------------------------------------------

# Tingkat log container API: debug | info | warning | error
LOG_LEVEL=info

# Label versi image yang dibangun. Biarkan `latest` kecuali ingin menyimpan
# beberapa versi image berdampingan (mis. sebelum dan sesudah perbaikan).
# Port publik HTTPS, hanya bila router meneruskan port tidak lazim
# (contoh: 8998 -> 443). Kosongkan bila 443 diteruskan apa adanya, agar
# pengalihan HTTP->HTTPS tidak menyisipkan nomor port yang keliru.
PUBLIC_HTTPS_PORT=

# Token Cloudflare Tunnel, hanya bila memakai docker-compose.cloudflare.yml.
# Diambil dari dasbor Cloudflare Zero Trust saat membuat tunnel.
# INI RAHASIA: siapa pun yang memegangnya dapat menyambungkan terowongan atas
# nama Anda. Jangan pernah dikirim lewat percakapan, chat, atau email.
CLOUDFLARE_TUNNEL_TOKEN=

IMAGE_TAG=latest
