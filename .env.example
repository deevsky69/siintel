# PREDIKSI PRESISI — contoh environment
# Salin ke .env untuk pengembangan lokal. JANGAN commit .env atau secret asli.

# ---------- Database ----------
# PostgreSQL + PostGIS.
# Nilai di bawah cocok dengan infra/docker/docker-compose.yml untuk pengembangan lokal.
# Belum dipakai untuk koneksi — koneksi dan migration dibuat pada TASK 010.
DATABASE_URL=postgresql+psycopg://predpol:predpol@localhost:5432/prediksi_presisi

# Dipakai oleh docker compose (pengembangan lokal saja, bukan kredensial produksi)
POSTGRES_USER=predpol
POSTGRES_PASSWORD=predpol
POSTGRES_DB=prediksi_presisi
POSTGRES_PORT=5432

# ---------- API ----------
API_BASE_URL=http://localhost:8000
API_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Autentikasi (SDL-06) ----------
# Isi dengan nilai acak yang kuat pada .env lokal. Jangan pakai nilai contoh.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
# Nilai TTL di atas adalah default teknis; kebijakan final menunggu pemilik proyek (U-05).

# ---------- Web ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- Peta / GIS (SDL-11) ----------
# Sumber tile belum ditetapkan pemilik proyek (U-15).
# Default pengembangan: tile server lokal via infra/docker.
MAP_STYLE_URL=http://localhost:8080/styles/basic/style.json
MAP_TILE_URL=http://localhost:8080/data/jakarta/{z}/{x}/{y}.pbf
NEXT_PUBLIC_MAP_STYLE_URL=http://localhost:8080/styles/basic/style.json
TILESERVER_PORT=8080

# ---------- Waktu & data demo (SDL-16, SDL-22) ----------
# Zona waktu tampilan. Penyimpanan selalu timestamptz (UTC).
APP_TIMEZONE=Asia/Jakarta
# Waktu acuan aplikasi. Data asli Pusiknas berposisi 29 September 2026 (kejadian terakhir
# 28 September); mengunci "sekarang" di tanggal itu membuat panel "7 hari terakhir" dan
# tren terkini membaca data yang memang ada, bukan rentang kosong setelah posisi data.
# Kosongkan untuk memakai waktu nyata; isi ISO-8601 untuk mengunci "sekarang".
DEMO_REFERENCE_TIME=2026-01-01T00:00:00+07:00
# Batas tampilan kejadian (keputusan pemilik proyek 4 Oktober 2026): layar hanya memuat
# kejadian sampai tanggal ini; kejadian sesudahnya hanya dibaca pencocokan rencana patroli
# dan evaluasi mundur. Kosongkan untuk tanpa batas.
DISPLAY_DATA_UNTIL=2025-12-31

# ---------- Konfigurasi analitik (SDL-18) ----------
# Bobot risk score dan threshold warning TIDAK di-hardcode.
RISK_CONFIG_PATH=config/risk/risk-weights.yaml
WARNING_CONFIG_PATH=config/risk/warning-thresholds.yaml
TAXONOMY_CONFIG_PATH=config/taxonomy/
