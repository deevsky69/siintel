# PREDIKSI PRESISI — contoh environment
# Salin ke .env untuk pengembangan lokal. JANGAN commit .env atau secret asli.

# ---------- Database ----------
# PostgreSQL + PostGIS
DATABASE_URL=postgresql+psycopg://predpol:predpol@localhost:5432/prediksi_presisi

# ---------- API ----------
API_BASE_URL=http://localhost:8000
API_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Autentikasi (SDL-06) ----------
# Isi dengan nilai acak yang kuat pada .env lokal. Jangan pakai nilai contoh.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
# Nilai TTL di atas adalah default teknis; kebijakan final menunggu pemilik proyek (U-05).

# ---------- Web ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- Peta / GIS (SDL-11) ----------
# Sumber tile belum ditetapkan pemilik proyek (U-15).
# Default pengembangan: tile server lokal via infra/docker.
MAP_STYLE_URL=http://localhost:8080/styles/basic/style.json
MAP_TILE_URL=http://localhost:8080/data/jakarta/{z}/{x}/{y}.pbf
NEXT_PUBLIC_MAP_STYLE_URL=http://localhost:8080/styles/basic/style.json

# ---------- Waktu & data demo (SDL-16, SDL-22) ----------
# Zona waktu tampilan. Penyimpanan selalu timestamptz (UTC).
APP_TIMEZONE=Asia/Jakarta
# Waktu acuan aplikasi untuk demo dengan dataset sintetis.
# Kosongkan untuk memakai waktu nyata; isi ISO-8601 untuk mengunci "sekarang" saat demo.
DEMO_REFERENCE_TIME=

# ---------- Konfigurasi analitik (SDL-18) ----------
# Bobot risk score dan threshold warning TIDAK di-hardcode.
RISK_CONFIG_PATH=config/risk/risk-weights.yaml
WARNING_CONFIG_PATH=config/risk/warning-thresholds.yaml
TAXONOMY_CONFIG_PATH=config/taxonomy/
